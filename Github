<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>GitHub Copilot 40분 실습 교재</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#23436c; --navy-hi:#2d5480;
    --bg:#f4f6f8; --card:#ffffff; --border:#e4e8ed;
    --text:#333333; --text2:#4a5568; --muted:#7b8794;
    --blue:#3182ce; --blue-dark:#2b6cb0; --blue-soft:#eaf2fb;
    --code-bg:#1f232b;
    --tip-bg:#fff9db; --tip-border:#f2e2a4; --tip-text:#6b5300;
    --green:#2f855a; --green-soft:#e8f5ee; --green-border:#bfe3cf;
    --amber:#b7791f; --red:#c53030;
    --shadow:0 1px 2px rgba(16,24,40,.05), 0 3px 10px rgba(16,24,40,.05);
    --radius:10px; --sidebar-w:296px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg); color:var(--text);
    font-family:"Noto Sans KR","Malgun Gothic",sans-serif;
    font-size:15.5px; line-height:1.75; -webkit-font-smoothing:antialiased;}
  a{color:var(--blue);text-decoration:none}
  a:hover{text-decoration:underline}
  code,.mono{font-family:"JetBrains Mono",monospace}

  /* ===== SIDEBAR ===== */
  .sidebar{position:fixed; inset:0 auto 0 0; width:var(--sidebar-w);
    background:var(--navy); color:#dbe6f3; display:flex; flex-direction:column;
    z-index:50; overflow-y:auto;}
  .brand{padding:26px 22px 20px}
  .brand h1{font-size:19px; font-weight:700; color:#fff; line-height:1.4}
  .brand .sub{font-size:12.5px; color:#a8bedb; margin-top:8px; line-height:1.6}
  .nav{padding:0 12px 22px}
  .nav-item{display:flex; align-items:center; gap:10px; width:100%; text-align:left;
    background:transparent; border:none; cursor:pointer; color:#c5d6ea;
    font-family:inherit; font-size:14px; padding:11px 14px; border-radius:8px;
    margin-bottom:2px; transition:background .16s, color .16s;}
  .nav-item:hover{background:rgba(255,255,255,.08); color:#fff}
  .nav-item.active{background:var(--navy-hi); color:#fff; font-weight:700}
  .nav-item .num{font-family:"JetBrains Mono",monospace; font-size:11.5px;
    font-weight:700; color:#8aa5c8; min-width:20px;}
  .nav-item.active .num{color:#cfe2ff}
  .nav-item .t{flex:1}
  .nav-item .m{font-family:"JetBrains Mono",monospace; font-size:11px; color:#8aa5c8}
  .nav-item.active .m{color:#cfe2ff}
  .nav-item.hero{border:1px solid rgba(255,255,255,.22)}
  .nav-sub{font-size:11px; letter-spacing:1.6px; color:#8aa5c8; font-weight:700;
    padding:16px 14px 8px;}
  .side-note{padding:0 22px 26px; font-size:11.5px; color:#9db4d4; line-height:1.7}
  .side-note b{color:#dbe6f3}

  /* ===== MAIN ===== */
  .main{margin-left:var(--sidebar-w); padding:44px 52px 110px}
  .page{display:none; max-width:940px}
  .page.show{display:block; animation:fade .28s ease}
  @keyframes fade{from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none}}
  @media (prefers-reduced-motion: reduce){.page.show{animation:none}}

  .page-tag{font-family:"JetBrains Mono",monospace; font-size:11.5px; font-weight:700;
    color:var(--blue); letter-spacing:1.2px; margin-bottom:8px;}
  .page > h2{font-size:29px; font-weight:700; color:var(--navy); line-height:1.35;
    padding-bottom:14px; border-bottom:2px solid var(--blue);}
  .page > .lede{color:var(--text2); font-size:15.5px; margin-top:16px; max-width:790px}

  .card{background:var(--card); border:1px solid var(--border); border-radius:var(--radius);
    box-shadow:var(--shadow); padding:26px 30px; margin-top:20px;}
  .card > h3{font-size:18px; font-weight:700; color:var(--navy);
    padding-bottom:10px; border-bottom:1px solid var(--border); margin-bottom:16px;
    display:flex; align-items:center; gap:10px; flex-wrap:wrap;}
  .card > h3 .tag{font-family:"JetBrains Mono",monospace; font-size:11px; font-weight:500;
    color:var(--blue); background:var(--blue-soft); border-radius:99px; padding:3px 11px;}
  .card > h3 .diff{margin-left:auto; display:flex; align-items:center; gap:7px}
  .card > h3 .diff i{width:8px; height:8px; border-radius:50%; background:#d7dee6; display:inline-block}
  .card > h3 .diff i.on{background:var(--blue)}
  .card > h3 .diff .lbl{font-size:11.5px; color:var(--muted); font-weight:400; margin-right:2px}
  .card p{font-size:15px; color:var(--text2)}
  .card p + p{margin-top:9px}
  .card strong{color:var(--text); font-weight:700}
  .card ul{margin:10px 0 0 2px; list-style:none}
  .card ul li{position:relative; padding-left:18px; margin-bottom:7px; font-size:15px; color:var(--text2)}
  .card ul li::before{content:""; position:absolute; left:2px; top:10px;
    width:5px; height:5px; border-radius:50%; background:var(--blue);}

  ol.proc{list-style:none; counter-reset:p; margin-top:4px}
  ol.proc li{position:relative; counter-increment:p; padding:0 0 14px 34px;
    font-size:15px; color:var(--text2);}
  ol.proc li::before{content:counter(p) "."; position:absolute; left:0; top:0;
    font-weight:700; color:var(--navy); font-size:15px;}
  ol.proc li:last-child{padding-bottom:0}
  .kbd{font-family:"JetBrains Mono",monospace; font-size:12px; background:#eef1f5;
    border:1px solid #dbe1e8; border-radius:5px; padding:1px 6px; color:#2d3748;
    white-space:nowrap;}

  /* spec grid (A/B 첨부 스펙 반영) */
  .spec{border:1px solid var(--border); border-radius:8px; overflow:hidden; margin-top:16px}
  .spec .row{display:flex; border-top:1px solid var(--border)}
  .spec .row:first-child{border-top:none}
  .spec .k{width:88px; flex-shrink:0; background:#f7f9fb; color:var(--navy);
    font-weight:700; font-size:14px; padding:10px 14px;}
  .spec .v{flex:1; padding:10px 16px; font-size:14.5px; color:var(--text2)}
  .spec-head{padding:12px 16px; font-weight:700; font-size:15.5px; color:#fff}

  /* collapsible hint */
  .hint{background:var(--card); border:1px solid var(--border); border-radius:var(--radius);
    box-shadow:var(--shadow); margin-top:20px; overflow:hidden;}
  .hint summary{list-style:none; cursor:pointer; user-select:none;
    display:flex; align-items:center; gap:11px; padding:17px 26px;
    font-size:15.5px; font-weight:700; color:var(--navy); transition:background .16s;}
  .hint summary::-webkit-details-marker{display:none}
  .hint summary:hover{background:#f7f9fb}
  .hint summary:focus-visible{outline:2px solid var(--blue); outline-offset:-2px}
  .hint summary .lock{font-family:"JetBrains Mono",monospace; font-size:10px;
    font-weight:700; letter-spacing:1px; color:var(--blue); background:var(--blue-soft);
    border-radius:99px; padding:3px 9px;}
  .hint summary .chev{margin-left:auto; color:var(--muted); font-size:12px; transition:transform .22s}
  .hint[open] summary .chev{transform:rotate(90deg)}
  .hint[open] summary{border-bottom:1px solid var(--border)}
  .hint-body{padding:22px 26px 26px; animation:slide .25s ease}
  @keyframes slide{from{opacity:0;transform:translateY(-5px)} to{opacity:1;transform:none}}

  .sec + .sec{margin-top:24px}
  .sec > h4{font-size:12px; letter-spacing:1.4px; font-weight:700; color:var(--muted);
    margin-bottom:10px; font-family:"JetBrains Mono",monospace;}
  .sec > h4.big{font-size:14px; letter-spacing:0; color:var(--navy);
    font-family:"Noto Sans KR",sans-serif; margin:22px 0 10px;
    padding-left:10px; border-left:3px solid var(--blue);}

  .prompt{position:relative; margin-bottom:12px}
  .prompt:last-child{margin-bottom:0}
  .prompt-box{background:var(--code-bg); border-radius:8px; padding:15px 74px 15px 17px;
    font-size:14.5px; color:#e8edf3; line-height:1.75;}
  .prompt-box .sub{display:block; margin-top:9px; padding-top:9px;
    border-top:1px solid #333c47; color:#9aa7b5; font-size:13px;}
  .copy{position:absolute; top:9px; right:9px; background:var(--blue); border:none;
    border-radius:6px; color:#fff; font-family:"Noto Sans KR",sans-serif;
    font-size:12px; font-weight:500; padding:5px 13px; cursor:pointer; transition:background .15s;}
  .copy:hover{background:var(--blue-dark)}
  .copy.done{background:var(--green)}

  .expect{background:var(--green-soft); border:1px solid var(--green-border);
    border-radius:8px; padding:14px 17px; font-size:14.5px; color:#276749;}
  .expect strong{color:#1c4532}
  .tip{background:var(--tip-bg); border:1px solid var(--tip-border); border-radius:8px;
    padding:14px 17px; font-size:14.5px; color:var(--tip-text); position:relative; margin-top:12px}
  .tip:first-child{margin-top:0}
  .tip b{color:#5b4700}
  .tip.labeled::before{content:"TIP"; position:absolute; top:-8px; left:14px;
    background:var(--tip-bg); border:1px solid var(--tip-border); border-radius:99px;
    font-family:"JetBrains Mono",monospace; font-size:9.5px; font-weight:700;
    color:var(--amber); padding:0 7px; letter-spacing:.6px;}
  .warn{background:#fff5f5; border:1px solid #f3c7c7; border-radius:8px;
    padding:14px 17px; font-size:14.5px; color:#822727;}
  .warn strong{color:var(--red)}

  pre.code{background:var(--code-bg); border-radius:8px; padding:15px 17px;
    overflow-x:auto; font-family:"JetBrains Mono",monospace; font-size:12.5px;
    line-height:1.7; color:#c9d4e0;}
  pre.code .cm{color:#7f8c9b}
  pre.code .kw{color:#ff8b8b}
  pre.code .st{color:#9ad1ff}

  table{width:100%; border-collapse:collapse; margin-top:12px; font-size:14.5px}
  th,td{border:1px solid var(--border); padding:9px 12px; text-align:left; vertical-align:top}
  th{background:#f7f9fb; color:var(--navy); font-weight:700; font-size:13.5px}
  td{color:var(--text2)}

  .tl{border:1px solid var(--border); border-radius:8px; overflow:hidden; margin-top:14px}
  .tl-row{display:flex; border-top:1px solid var(--border)}
  .tl-row:first-child{border-top:none}
  .tl-t{font-family:"JetBrains Mono",monospace; font-size:12px; font-weight:700;
    color:var(--blue); width:96px; padding:12px 0 12px 16px; flex-shrink:0; background:#fafbfc}
  .tl-c{flex:1; padding:12px 16px; display:flex; align-items:center; gap:12px;
    font-size:14.5px; color:var(--text2)}
  .tl-c b{color:var(--text)}
  .tl-bar{height:8px; border-radius:99px; background:var(--blue); flex-shrink:0}

  .grid2{display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:20px}
  .grid2 .card{margin-top:0; padding:22px 24px}
  .grid2 .card h4{font-size:15px; font-weight:700; color:var(--navy); margin-bottom:12px;
    padding-bottom:8px; border-bottom:1px solid var(--border)}

  .hero-note{background:linear-gradient(135deg,#eef5fd,#f8fbff);
    border:1px solid #cfe3f7; border-left:4px solid var(--blue); border-radius:8px;
    padding:18px 22px; margin-top:20px;}
  .hero-note h4{color:var(--navy); font-size:15.5px; font-weight:700; margin-bottom:6px}
  .hero-note p{font-size:14.5px; color:var(--text2)}

  @media (max-width: 980px){
    .sidebar{position:static; width:100%}
    .main{margin-left:0; padding:28px 20px 80px}
    .grid2{grid-template-columns:1fr}
  }
</style>
</head>
<body>

<!-- ================= SIDEBAR ================= -->
<aside class="sidebar">
  <div class="brand">
    <h1>GitHub Copilot<br>실습 교재</h1>
    <div class="sub">30분 강의 이후 진행하는 40분 실습 · VS Code에서 전부 실행</div>
  </div>

  <nav class="nav" id="nav">
    <button class="nav-item active" data-page="overview">
      <span class="num">00</span><span class="t">준비 사항</span><span class="m">2m</span>
