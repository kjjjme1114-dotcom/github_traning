<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
(function(){
  var order = ['overview','lab1','lab2','lab3','lab4','appendix'];
  var pages = {}, buttons = document.querySelectorAll('.nav-item');
  order.forEach(function(k){ pages[k] = document.getElementById('page-' + k); });

  function show(key){
    if (order.indexOf(key) < 0) key = 'overview';
    order.forEach(function(k){ pages[k].classList.toggle('show', k === key); });
    buttons.forEach(function(b){ b.classList.toggle('active', b.dataset.page === key); });
    if (('#' + key) !== location.hash) history.replaceState(null, '', '#' + key);
    window.scrollTo(0, 0);
  }
  buttons.forEach(function(b){ b.addEventListener('click', function(){ show(b.dataset.page); }); });
  if (location.hash) show(location.hash.slice(1));
  window.addEventListener('hashchange', function(){ show(location.hash.slice(1)); });

  document.querySelectorAll('.copy').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var text = btn.getAttribute('data-copy');
      if (!text) return;
      function ok(){
        btn.textContent = '복사됨'; btn.classList.add('done');
        setTimeout(function(){ btn.textContent = '복사'; btn.classList.remove('done'); }, 1600);
      }
      function fallback(){
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); ok(); } catch(err){}
        document.body.removeChild(ta);
      }
      if (navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(text).then(ok).catch(fallback);
      } else { fallback(); }
    });
  });

  document.addEventListener('keydown', function(e){
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    var idx = order.findIndex(function(k){ return pages[k].classList.contains('show'); });
    if (e.key === 'ArrowRight' && idx > -1 && idx < order.length - 1) show(order[idx + 1]);
    if (e.key === 'ArrowLeft' && idx > 0) show(order[idx - 1]);
  });
})();
</script>
